rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read/write their own private data (including safety PIN metadata)
    match /users/{userId}/private/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Daily financial logs (one doc per calendar day: YYYY-MM-DD)
    match /users/{userId}/dailyLogs/{dateKey} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Planning goals collection
    match /users/{userId}/planningGoals/{goalId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Savings goals collection
    match /users/{userId}/savingsGoals/{goalId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Savings transactions collection
    match /users/{userId}/savingsTransactions/{transactionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Goal completion logs collection
    match /users/{userId}/goalCompletionLogs/{logId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
